{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "productowner-skill-onboarding-tab",
  "packageName": "com.vvs-PO.pmos.onboarding",
  "developer": {
    "name": "Vignesh AIPM",
    "websiteUrl": "https://vvs-PO.github.io/productowner-skill",
    "privacyUrl": "https://vvs-PO.github.io/productowner-skill/onboarding/",
