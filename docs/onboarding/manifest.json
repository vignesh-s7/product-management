    },
    {
      "entityId": "cucp-deck",
      "name": "CuCP Rollout",
      "contentUrl": "https://vvs-PO.github.io/productowner-skill/cucp/presentation.html",
      "websiteUrl": "https://vvs-PO.github.io/productowner-skill/cucp/presentation.html",
      "scopes": ["personal", "team"]
    }
  ],
  "configurableTabs": [
    {
      "configurationUrl": "https://vvs-PO.github.io/productowner-skill/onboarding/teams.html?config=1",
      "canUpdateConfiguration": true,
      "scopes": ["team", "groupChat"],
      "supportedSharePointHosts": ["sharePointFullPage", "sharePointWebPart"]
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
